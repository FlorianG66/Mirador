# Modèle de variables d'environnement — copier vers `.env` (jamais commité).
# Valeurs de développement uniquement : aucun secret réel ici.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=mirador
POSTGRES_PASSWORD=mirador-dev-local
POSTGRES_DB=mirador
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://mirador:mirador-dev-local@localhost:5432/mirador
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Base du frontend (liens envoyés par e-mail, ex. réinitialisation de mot de passe).
APP_BASE_URL=http://localhost:5173
# Worker de données fictives : intervalle de synchronisation en minutes (0 = désactivé).
SYNC_INTERVAL_MINUTES=5
# Mode démo : durée d'une session fictive et d'un lien pour un prospect.
DEMO_SESSION_TTL_MINUTES=60
DEMO_LINK_TTL_HOURS=72

# --- Chatbot IA (phase 8) ---
# Vide = assistant désactivé (503). Clé de la console Anthropic, jamais commitée.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Questions par utilisateur et par jour (plafond réduit en démo).
CHAT_DAILY_QUOTA=50
CHAT_DEMO_DAILY_QUOTA=10

# --- Connexion Google (OIDC) ---
# Vide = routes /auth/google en 404 (connexion Google inactive).
# Identifiants de l'écran « Identifiants OAuth » de la console Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Web Push (notifications hors onglet) ---
# Vide = Web Push désactivé (la clé publique renvoie 404 et rien n'est poussé).
# Générer des clés VAPID de développement (jamais les committer) :
#   vapid --gen --applicationServerKey
# VAPID_PRIVATE_KEY = clé privée ; VAPID_PUBLIC_KEY = clé publique remise au navigateur.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# URL de contact exigée par les services de push (ex. mailto:admin@exemple.fr) ;
# vide = APP_BASE_URL utilisée telle quelle.
VAPID_SUBJECT=
