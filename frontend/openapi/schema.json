{
  "openapi": "3.1.0",
  "info": {
    "title": "Mirador",
    "description": "API Mirador — dashboard d'entreprise",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "summary": "Register",
        "description": "Inscription : crée le compte, son organisation et le rattachement admin.",
        "operationId": "register_api_v1_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login",
        "description": "Connexion : réponse unique sur l'échec, puis session ou défi A2F.\n\nQuand le TOTP est actif, aucun cookie de session n'est posé : un défi de\n5 minutes est distribué et devra être échangé contre une session dans\n`/auth/2fa/verify`.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "Refresh",
        "description": "Tourne les jetons d'accès et de rafraîchissement (rotation à chaque usage).",
        "operationId": "refresh_api_v1_auth_refresh_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Refresh Api V1 Auth Refresh Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Logout",
        "description": "Révoque la session côté base puis efface les cookies.",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Me",
        "description": "Utilisateur courant et ses organisations (tenant utilisateur déjà posé).",
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/google": {
      "get": {
        "summary": "Start",
        "description": "Pose l'état dans un cookie httpOnly puis renvoie l'URL d'autorisation Google.",
        "operationId": "start_api_v1_auth_google_get",
        "responses": {
          "302": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/google/callback": {
      "get": {
        "summary": "Callback",
        "description": "Valide l'état, échange le code puis ouvre la session (ou relève le défi A2F).\n\nUne erreur du fournisseur (`OidcProviderError`) remonte jusqu'au gestionnaire\ncentral : 502 à détail figé, le détail technique n'est que journalisé.",
        "operationId": "callback_api_v1_auth_google_callback_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/2fa/verify": {
      "post": {
        "summary": "Verify",
        "description": "Échange le défi (cookie `mirador_2fa`) contre une session complète.\n\nLe défi est à usage unique : il est consommé, que le code soit un TOTP ou un\ncode de secours (les codes de secours sont aussi consommés à l'usage).",
        "operationId": "verify_api_v1_auth_2fa_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TwoFactorVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/2fa/enable": {
      "post": {
        "summary": "Enable",
        "description": "Active (ou réactive) le TOTP : le secret et les codes sont montrés une fois.",
