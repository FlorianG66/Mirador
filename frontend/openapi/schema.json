  "components": {
    "schemas": {
      "AcceptInvitationRequest": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Token"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid",
            "title": "Organization Id"
          }
        },
        "type": "object",
        "required": [
          "token",
          "organization_id"
        ],
        "title": "AcceptInvitationRequest",
        "description": "Acceptation : le lien d'e-mail contient le jeton et l'organisation."
      },
      "AcceptInvitationResponse": {
        "properties": {
